		$fieldKey = sanitizeString((string)($_POST['fieldKey'] ?? ''));
		$x = (int)($_POST['x'] ?? 0);
		$y = (int)($_POST['y'] ?? 0);
		$width = (int)($_POST['width'] ?? 200);
